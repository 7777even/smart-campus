<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.mappers.MajorMapper">

    <resultMap id="BaseResultMap" type="com.campus.entity.Major">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="name" property="name" jdbcType="VARCHAR"/>
        <result column="code" property="code" jdbcType="VARCHAR"/>
        <result column="department_id" property="departmentId" jdbcType="BIGINT"/>
        <result column="level" property="level" jdbcType="VARCHAR"/>
        <result column="years" property="years" jdbcType="INTEGER"/>
        <result column="status" property="status" jdbcType="INTEGER"/>
        <result column="sort" property="sort" jdbcType="INTEGER"/>
        <result column="description" property="description" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="BaseColumns">
        id, name, code, department_id, level, years, status, sort, description, create_time, update_time
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/> FROM sys_major WHERE id = #{id}
    </select>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/> FROM sys_major
        WHERE 1=1
        <if test="keyword != null and keyword != ''">
            AND (name LIKE CONCAT('%', #{keyword}, '%') OR code LIKE CONCAT('%', #{keyword}, '%'))
        </if>
        <if test="departmentId != null and departmentId != ''">
            AND department_id = #{departmentId}
        </if>
        <if test="level != null and level != ''">
            AND level = #{level}
        </if>
        ORDER BY sort ASC, id DESC
        LIMIT #{pageSize} OFFSET #{pageNo}
    </select>

    <select id="selectCount" resultType="long">
        SELECT COUNT(*) FROM sys_major
        WHERE 1=1
        <if test="keyword != null and keyword != ''">
            AND (name LIKE CONCAT('%', #{keyword}, '%') OR code LIKE CONCAT('%', #{keyword}, '%'))
        </if>
        <if test="departmentId != null and departmentId != ''">
            AND department_id = #{departmentId}
        </if>
        <if test="level != null and level != ''">
            AND level = #{level}
        </if>
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_major (name, code, department_id, level, years, status, sort, description)
        VALUES (#{name}, #{code}, #{departmentId}, #{level}, #{years}, #{status}, #{sort}, #{description})
    </insert>

    <update id="update">
        UPDATE sys_major
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="code != null">code = #{code},</if>
            <if test="departmentId != null">department_id = #{departmentId},</if>
            <if test="level != null">level = #{level},</if>
            <if test="years != null">years = #{years},</if>
            <if test="status != null">status = #{status},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="description != null">description = #{description},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM sys_major WHERE id = #{id}
    </delete>

    <delete id="deleteByIds">
        DELETE FROM sys_major WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
