<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.mappers.AiMessageMapper">

    <resultMap id="BaseResultMap" type="com.campus.entity.AiMessage">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="conversation_id" property="conversationId" jdbcType="BIGINT"/>
        <result column="role" property="role" jdbcType="VARCHAR"/>
        <result column="content" property="content" jdbcType="VARCHAR"/>
        <result column="tokens" property="tokens" jdbcType="INTEGER"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="BaseColumns">
        id, conversation_id, role, content, tokens, create_time
    </sql>

    <select id="selectByConversationId" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/> FROM ai_message
        WHERE conversation_id = #{conversationId}
        ORDER BY id ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ai_message (conversation_id, role, content, tokens, create_time)
        VALUES (#{conversationId}, #{role}, #{content}, #{tokens}, NOW())
    </insert>

    <delete id="deleteByConversationId">
        DELETE FROM ai_message WHERE conversation_id = #{conversationId}
    </delete>

</mapper>
