<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.mappers.SysUserMapper">

    <resultMap id="BaseResultMap" type="com.campus.entity.SysUser">
        <id column="id" property="id" />
        <result column="username" property="username" />
        <result column="password" property="password" />
        <result column="real_name" property="realName" />
        <result column="role" property="role" />
        <result column="email" property="email" />
        <result column="avatar" property="avatar" />
        <result column="phone" property="phone" />
        <result column="status" property="status" />
        <result column="student_id" property="studentId" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <sql id="Base_Column_List">
        id, username, password, real_name, role, email, avatar, phone, status, student_id, create_time, update_time
    </sql>

    <sql id="Where_Clause">
        <where>
            <if test="keyword != null and keyword != ''">
                AND (username LIKE CONCAT('%', #{keyword}, '%')
                     OR real_name LIKE CONCAT('%', #{keyword}, '%')
                     OR phone LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="role != null and role != ''">
                AND role = #{role}
            </if>
        </where>
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM sys_user WHERE id = #{id}
    </select>

    <select id="selectByUsername" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM sys_user WHERE username = #{username}
    </select>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM sys_user
        <include refid="Where_Clause" />
        ORDER BY create_time DESC
        <if test="pageNo != null and pageSize != null">
            LIMIT #{pageNo}, #{pageSize}
        </if>
    </select>

    <select id="selectCount" resultType="long">
        SELECT COUNT(*) FROM sys_user
        <include refid="Where_Clause" />
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_user (username, password, real_name, role, email, avatar, phone, status, create_time, update_time)
        VALUES (#{username}, #{password}, #{realName}, #{role}, #{email}, #{avatar}, #{phone}, #{status}, NOW(), NOW())
    </insert>

    <update id="update">
        UPDATE sys_user
        SET username = #{username},
            real_name = #{realName},
            role = #{role},
            email = #{email},
            avatar = #{avatar},
            phone = #{phone},
            status = #{status},
            update_time = NOW()
        WHERE id = #{id}
    </update>

    <update id="toggleStatus">
        UPDATE sys_user
        SET status = CASE WHEN status = 0 THEN 1 ELSE 0 END,
            update_time = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM sys_user WHERE id = #{id}
    </delete>

    <delete id="deleteByIds">
        DELETE FROM sys_user WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
