<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smart.campus.web.mappers.LessonResourceMapper">

    <resultMap id="BaseResultMap" type="com.smart.campus.web.entity.LessonResource">
        <id column="id" property="id" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="lesson_id" property="lessonId" />
        <result column="resource_id" property="resourceId" />
        <result column="resource_type" property="resourceType" />
        <result column="resource_url" property="resourceUrl" />
    </resultMap>

    <sql id="BaseColumns">
        id, create_time, update_time, lesson_id, resource_id, resource_type, resource_url
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns" /> FROM biz_lesson_resource WHERE id = #{id}
    </select>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns" /> FROM biz_lesson_resource
        <where>
            <if test="lessonId != null">
                AND lesson_id = #{lessonId}
            </if>
        </where>
        ORDER BY id ASC
    </select>

    <select id="selectCount" resultType="long">
        SELECT COUNT(*) FROM biz_lesson_resource
        <where>
            <if test="lessonId != null">
                AND lesson_id = #{lessonId}
            </if>
        </where>
    </select>

    <select id="selectByLessonId" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns" /> FROM biz_lesson_resource
        WHERE lesson_id = #{lessonId}
        ORDER BY id ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO biz_lesson_resource (lesson_id, resource_id, resource_type, resource_url,
                                         create_time, update_time)
        VALUES (#{lessonId}, #{resourceId}, #{resourceType}, #{resourceUrl}, NOW(), NOW())
    </insert>

    <update id="update">
        UPDATE biz_lesson_resource
        <set>
            <if test="lessonId != null">lesson_id = #{lessonId},</if>
            <if test="resourceId != null">resource_id = #{resourceId},</if>
            <if test="resourceType != null">resource_type = #{resourceType},</if>
            <if test="resourceUrl != null">resource_url = #{resourceUrl},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM biz_lesson_resource WHERE id = #{id}
    </delete>

    <delete id="deleteByLessonId">
        DELETE FROM biz_lesson_resource WHERE lesson_id = #{lessonId}
    </delete>

</mapper>
