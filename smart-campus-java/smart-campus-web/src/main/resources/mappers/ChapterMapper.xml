<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smart.campus.web.mappers.ChapterMapper">

    <resultMap id="BaseResultMap" type="com.smart.campus.web.entity.Chapter">
        <id column="id" property="id" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="course_id" property="courseId" />
        <result column="name" property="name" />
        <result column="sort" property="sort" />
        <result column="status" property="status" />
    </resultMap>

    <sql id="BaseColumns">
        id, create_time, update_time, course_id, name, sort, status
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns" /> FROM biz_chapter WHERE id = #{id}
    </select>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns" /> FROM biz_chapter
        <where>
            <if test="courseId != null and courseId != ''">
                AND course_id = #{courseId}
            </if>
        </where>
        ORDER BY sort ASC, id ASC
    </select>

    <select id="selectCount" resultType="long">
        SELECT COUNT(*) FROM biz_chapter
        <where>
            <if test="courseId != null and courseId != ''">
                AND course_id = #{courseId}
            </if>
        </where>
    </select>

    <select id="selectByCourseId" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns" /> FROM biz_chapter
        WHERE course_id = #{courseId}
        ORDER BY sort ASC, id ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO biz_chapter (course_id, name, sort, status, create_time, update_time)
        VALUES (#{courseId}, #{name}, #{sort}, #{status}, NOW(), NOW())
    </insert>

    <update id="update">
        UPDATE biz_chapter
        <set>
            <if test="courseId != null">course_id = #{courseId},</if>
            <if test="name != null">name = #{name},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM biz_chapter WHERE id = #{id}
    </delete>

    <delete id="deleteByCourseId">
        DELETE FROM biz_chapter WHERE course_id = #{courseId}
    </delete>

</mapper>
