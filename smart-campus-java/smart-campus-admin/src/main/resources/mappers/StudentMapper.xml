<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smart.campus.admin.mappers.StudentMapper">

    <resultMap id="BaseResultMap" type="com.smart.campus.admin.entity.Student">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="student_no" property="studentNo" jdbcType="VARCHAR"/>
        <result column="name" property="name" jdbcType="VARCHAR"/>
        <result column="gender" property="gender" jdbcType="VARCHAR"/>
        <result column="department_id" property="departmentId" jdbcType="BIGINT"/>
        <result column="major_id" property="majorId" jdbcType="BIGINT"/>
        <result column="class_id" property="classId" jdbcType="BIGINT"/>
        <result column="phone" property="phone" jdbcType="VARCHAR"/>
        <result column="email" property="email" jdbcType="VARCHAR"/>
        <result column="password" property="password" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="VARCHAR"/>
        <result column="address" property="address" jdbcType="VARCHAR"/>
        <result column="avatar" property="avatar" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="BaseColumns">
        id, student_no, name, gender, department_id, major_id, class_id, phone, email,
        password, status, address, avatar, create_time, update_time
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/> FROM sys_student WHERE id = #{id}
    </select>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/> FROM sys_student
        WHERE 1=1
        <if test="keyword != null and keyword != ''">
            AND (student_no LIKE CONCAT('%', #{keyword}, '%') OR name LIKE CONCAT('%', #{keyword}, '%'))
        </if>
        <if test="departmentId != null and departmentId != ''">
            AND department_id = #{departmentId}
        </if>
        <if test="majorId != null and majorId != ''">
            AND major_id = #{majorId}
        </if>
        <if test="gender != null and gender != ''">
            AND gender = #{gender}
        </if>
        <if test="status != null and status != ''">
            AND status = #{status,jdbcType=INTEGER}
        </if>
        ORDER BY id DESC
        LIMIT #{pageSize} OFFSET #{pageNo}
    </select>

    <select id="selectCount" resultType="long">
        SELECT COUNT(*) FROM sys_student
        WHERE 1=1
        <if test="keyword != null and keyword != ''">
            AND (student_no LIKE CONCAT('%', #{keyword}, '%') OR name LIKE CONCAT('%', #{keyword}, '%'))
        </if>
        <if test="departmentId != null and departmentId != ''">
            AND department_id = #{departmentId}
        </if>
        <if test="majorId != null and majorId != ''">
            AND major_id = #{majorId}
        </if>
        <if test="gender != null and gender != ''">
            AND gender = #{gender}
        </if>
        <if test="status != null and status != ''">
            AND status = #{status,jdbcType=INTEGER}
        </if>
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_student (student_no, name, gender, department_id, major_id, class_id,
                                 phone, email, password, status, address, avatar)
        VALUES (#{studentNo}, #{name}, #{gender}, #{departmentId}, #{majorId}, #{classId},
                #{phone}, #{email}, #{password}, #{status}, #{address}, #{avatar})
    </insert>

    <update id="update">
        UPDATE sys_student
        <set>
            <if test="studentNo != null">student_no = #{studentNo},</if>
            <if test="name != null">name = #{name},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="departmentId != null">department_id = #{departmentId},</if>
            <if test="majorId != null">major_id = #{majorId},</if>
            <if test="classId != null">class_id = #{classId},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="email != null">email = #{email},</if>
            <if test="password != null">password = #{password},</if>
            <if test="status != null">status = #{status},</if>
            <if test="address != null">address = #{address},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM sys_student WHERE id = #{id}
    </delete>

    <delete id="deleteByIds">
        DELETE FROM sys_student WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
