<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smart.campus.admin.mappers.AiEarlyWarningMapper">

    <resultMap id="BaseResultMap" type="com.smart.campus.admin.entity.AiEarlyWarning">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="student_id" property="studentId" jdbcType="BIGINT"/>
        <result column="profile_id" property="profileId" jdbcType="BIGINT"/>
        <result column="warning_type" property="warningType" jdbcType="VARCHAR"/>
        <result column="level" property="level" jdbcType="VARCHAR"/>
        <result column="score" property="score" jdbcType="DECIMAL"/>
        <result column="threshold" property="threshold" jdbcType="DECIMAL"/>
        <result column="description" property="description" jdbcType="VARCHAR"/>
        <result column="suggestion" property="suggestion" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="VARCHAR"/>
        <result column="resolver" property="resolver" jdbcType="VARCHAR"/>
        <result column="resolve_time" property="resolveTime" jdbcType="TIMESTAMP"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="BaseColumns">
        id, student_id, profile_id, warning_type, level, score, threshold,
        description, suggestion, status, resolver, resolve_time, create_time, update_time
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/> FROM ai_early_warning WHERE id = #{id}
    </select>

    <select id="selectByStudentId" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/> FROM ai_early_warning
        WHERE student_id = #{studentId}
        ORDER BY create_time DESC
    </select>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/> FROM ai_early_warning
        WHERE 1=1
        <if test="level != null and level != ''">
            AND level = #{level}
        </if>
        <if test="status != null and status != ''">
            AND status = #{status}
        </if>
        <if test="warningType != null and warningType != ''">
            AND warning_type = #{warningType}
        </if>
        ORDER BY
        <if test="sortField == null or sortField == ''">
            create_time DESC
        </if>
        <if test="sortField != null and sortField != ''">
            ${sortField} ${sortOrder}
        </if>
        LIMIT #{pageSize} OFFSET #{pageNo}
    </select>

    <select id="selectCount" resultType="long">
        SELECT COUNT(*) FROM ai_early_warning
        WHERE 1=1
        <if test="level != null and level != ''">
            AND level = #{level}
        </if>
        <if test="status != null and status != ''">
            AND status = #{status}
        </if>
        <if test="warningType != null and warningType != ''">
            AND warning_type = #{warningType}
        </if>
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ai_early_warning (student_id, profile_id, warning_type, level, score, threshold,
            description, suggestion, status, create_time, update_time)
        VALUES (#{studentId}, #{profileId}, #{warningType}, #{level}, #{score}, #{threshold},
            #{description}, #{suggestion}, #{status}, NOW(), NOW())
    </insert>

    <update id="update">
        UPDATE ai_early_warning
        <set>
            <if test="status != null">status = #{status},</if>
            <if test="resolver != null">resolver = #{resolver},</if>
            <if test="resolveTime != null">resolve_time = #{resolveTime},</if>
            <if test="suggestion != null">suggestion = #{suggestion},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM ai_early_warning WHERE id = #{id}
    </delete>

    <delete id="deleteByIds">
        DELETE FROM ai_early_warning WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
