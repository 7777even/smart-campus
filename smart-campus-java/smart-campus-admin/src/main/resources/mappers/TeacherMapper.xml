<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smart.campus.admin.mappers.TeacherMapper">

    <resultMap id="BaseResultMap" type="com.smart.campus.admin.entity.Teacher">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="teacher_no" property="teacherNo" jdbcType="VARCHAR"/>
        <result column="name" property="name" jdbcType="VARCHAR"/>
        <result column="gender" property="gender" jdbcType="VARCHAR"/>
        <result column="department_id" property="departmentId" jdbcType="BIGINT"/>
        <result column="title" property="title" jdbcType="VARCHAR"/>
        <result column="degree" property="degree" jdbcType="VARCHAR"/>
        <result column="phone" property="phone" jdbcType="VARCHAR"/>
        <result column="email" property="email" jdbcType="VARCHAR"/>
        <result column="password" property="password" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="INTEGER"/>
        <result column="intro" property="intro" jdbcType="VARCHAR"/>
        <result column="avatar" property="avatar" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="BaseColumns">
        id, teacher_no, name, gender, department_id, title, degree, phone, email,
        password, status, intro, avatar, create_time, update_time
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/> FROM sys_teacher WHERE id = #{id}
    </select>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/> FROM sys_teacher
        WHERE 1=1
        <if test="keyword != null and keyword != ''">
            AND (teacher_no LIKE CONCAT('%', #{keyword}, '%') OR name LIKE CONCAT('%', #{keyword}, '%'))
        </if>
        <if test="departmentId != null and departmentId != ''">
            AND department_id = #{departmentId}
        </if>
        <if test="title != null and title != ''">
            AND title = #{title}
        </if>
        ORDER BY id DESC
        LIMIT #{pageSize} OFFSET #{pageNo}
    </select>

    <select id="selectCount" resultType="long">
        SELECT COUNT(*) FROM sys_teacher
        WHERE 1=1
        <if test="keyword != null and keyword != ''">
            AND (teacher_no LIKE CONCAT('%', #{keyword}, '%') OR name LIKE CONCAT('%', #{keyword}, '%'))
        </if>
        <if test="departmentId != null and departmentId != ''">
            AND department_id = #{departmentId}
        </if>
        <if test="title != null and title != ''">
            AND title = #{title}
        </if>
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_teacher (teacher_no, name, gender, department_id, title, degree,
                                 phone, email, password, status, intro, avatar)
        VALUES (#{teacherNo}, #{name}, #{gender}, #{departmentId}, #{title}, #{degree},
                #{phone}, #{email}, #{password}, #{status}, #{intro}, #{avatar})
    </insert>

    <update id="update">
        UPDATE sys_teacher
        <set>
            <if test="teacherNo != null">teacher_no = #{teacherNo},</if>
            <if test="name != null">name = #{name},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="departmentId != null">department_id = #{departmentId},</if>
            <if test="title != null">title = #{title},</if>
            <if test="degree != null">degree = #{degree},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="email != null">email = #{email},</if>
            <if test="password != null">password = #{password},</if>
            <if test="status != null">status = #{status},</if>
            <if test="intro != null">intro = #{intro},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM sys_teacher WHERE id = #{id}
    </delete>

    <delete id="deleteByIds">
        DELETE FROM sys_teacher WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
